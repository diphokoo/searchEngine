# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_intelligence
DB_USER=postgres
DB_PASSWORD=Freddy@12

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=24h

# ─── Mining Engine ────────────────────────────────────────────────────────────
MINING_ENGINE_URL=http://localhost:8000
MINING_ENGINE_API_KEY=internal-key

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── AWS / S3 ─────────────────────────────────────────────────────────────────
AWS_REGION=af-south-1
S3_BUCKET=event-intelligence-assets
# S3_ENDPOINT=http://localhost:9000  # Uncomment for local MinIO

# ─── Instagram Graph API ──────────────────────────────────────────────────────
# 1. Create a Meta Developer App: https://developers.facebook.com/apps
# 2. Add Instagram Graph API product
# 3. Generate a long-lived Page Access Token via Graph Explorer:
#    https://developers.facebook.com/tools/explorer
# 4. Required permissions: instagram_basic, pages_read_engagement
INSTAGRAM_ACCESS_TOKEN=

# ─── Facebook Graph API ───────────────────────────────────────────────────────
# Same Meta Developer App as Instagram above
# Required permissions: public_profile, pages_read_engagement
FACEBOOK_APP_ID=2322453235261979
FACEBOOK_APP_SECRET=902e43d1e45c2244d3f73d43d8bf3bdb

# ─── Twitter / X API v2 ───────────────────────────────────────────────────────
# 1. Apply at: https://developer.twitter.com/en/portal/dashboard
# 2. Create a Project + App, copy the Bearer Token
# Note: Free tier = 1 req/15min, 10 results. Basic = $100/mo for more.
TWITTER_BEARER_TOKEN=

# ─── TikTok Research API ──────────────────────────────────────────────────────
# 1. Apply at: https://developers.tiktok.com/products/research-api
# 2. Requires app review and approval by TikTok
# 3. Copy Client Key and Client Secret from your approved app
TIKTOK_API_KEY=
TIKTOK_API_SECRET=


# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_intelligence
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=24h

# ─── Mining Engine ────────────────────────────────────────────────────────────
MINING_ENGINE_URL=http://localhost:8000
MINING_ENGINE_API_KEY=internal-key

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── AWS / S3 ─────────────────────────────────────────────────────────────────
AWS_REGION=af-south-1
S3_BUCKET=event-intelligence-assets
# S3_ENDPOINT=http://localhost:9000  # Uncomment for local MinIO

